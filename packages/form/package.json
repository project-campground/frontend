{
	"name": "@campground/form",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"keywords": [
		"campground"
	],
	"description": "Campground forms, form fields and similar.",
	"author": "Team Campground",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"main": "./dist/index.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"sass": "./src/dist/index.scss",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"sass": "./dist/index.scss"
		},
		"./css/*.scss": {
			"sass": "./dist/css/*.scss"
		},
		"./dist/_index": {
			"sass": "./dist/index.scss"
		},
		"./dist/*": {
			"sass": "./dist/*.scss"
		},
		"./dist/css/*.scss": {
			"sass": "./dist/css/*.scss"
		}
	},
	"dependencies": {
		"@campground/locale": "1.0.0",
		"@campground/ui": "1.0.0",
		"@tsconfig/svelte": "^5.0.8",
		"@formatjs/svelte-intl": "^1.1.6"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@campground/svelte-config": "1.0.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tabler/icons-svelte": "^3.34.1",
		"@types/node": "^24",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"sass": "^1.99.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-plugin-static-copy": "^2.3.0"
	}
}
