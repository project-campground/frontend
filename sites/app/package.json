{
	"name": "@campground/app",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"keywords": [
		"campground"
	],
	"description": "Campground platform interface, web app or official client.",
	"author": "Team Campground",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"main": "./dist/index.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"sass": "./src/lib/index.scss",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@campground/form": "1.0.0",
		"@campground/locale": "1.0.0",
		"@campground/ui": "1.0.0",
		"@fontsource-variable/ubuntu-sans": "^5.2.10",
		"@fontsource/ubuntu": "^5.2.8",
		"@fontsource/ubuntu-mono": "^5.2.8",
		"@formatjs/svelte-intl": "^1.1.4",
		"@tabler/icons-svelte": "^3.34.1",
		"@types/mdast": "^4.0.4",
		"cbor2": "^2.0.1",
		"highlight.js": "^11.11.1",
		"isbot": "^5",
		"mdast-util-find-and-replace": "^3.0.2",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"micromark-extension-gfm": "^3.0.0",
		"ms": "^2.1.3",
		"prosekit": "^0.22.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@campground/svelte-config": "1.0.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/ms": "^2.1.0",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"sass": "^1.86.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-plugin-static-copy": "^2.3.0"
	}
}
