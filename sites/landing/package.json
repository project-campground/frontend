{
	"name": "@campground/landing",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"keywords": [
		"campground"
	],
	"description": "Campground landing & guide website.",
	"author": "Team Campground",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"main": "./dist/index.ts",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"sass": "./src/lib/index.scss",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"sass": "./dist/index.scss"
		}
	},
	"dependencies": {
		"@campground/locale": "1.0.0",
		"@campground/ui": "1.0.0",
		"@fontsource-variable/ubuntu-sans": "^5.2.10",
		"@fontsource/ubuntu": "^5.2.8",
		"@fontsource/ubuntu-mono": "^5.2.8",
		"@formatjs/svelte-intl": "^1.1.6",
		"@tabler/icons-svelte": "^3.42.0",
		"dayjs": "^1.11.13",
		"ua-parser-js": "^2.0.9"
	},
	"devDependencies": {
		"@campground/svelte-config": "1.0.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"autoprefixer": "^10.5.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"sass": "^1.86.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.12",
		"vite-plugin-static-copy": "^2.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
